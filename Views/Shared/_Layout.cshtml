
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Warzywniak</title>

    <script type="importmap"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Warzywniak.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">


    <header>
        <nav class="navbar bg-white border-bottom shadow-sm py-2">

            <div class="container-fluid px-3 header-layout">

                <!--lewa str menu-->

                <div class="dropdown">

                    <button class="btn btn-outline-dark dropdown-toggle d-flex align-items-center gap-2"
                            type="button"
                            id="mainMenu"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        <i class="bi bi-list fs-5"></i>
                        <span>Menu</span>

                    </button>

                    <ul class="dropdown-menu shadow mt-2"
                        aria-labelledby="mainMenu">

                        <li>
                            <a class="dropdown-item py-2"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-2"></i>
                                Home

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item py-2"
                               asp-controller="Home"
                               asp-action="Privacy">

                                <i class="bi bi-shield-check me-2"></i>
                                Privacy

                            </a>
                        </li>

                    </ul>

                </div>


                <!--srodek menu-->

                <div class="header-brand-group">

                    <!--lewy ornament-->

                    <svg class="header-ornament ornament-left"
                         viewBox="0 0 50 100"
                         xmlns="http://www.w3.org/2000/svg"
                         aria-hidden="true">

                        <path d="
                            M37 2
                            C20 0 10 12 17 23
                            C23 33 38 28 35 18
                            C33 11 24 13 23 19

                            M17 23
                            C5 31 8 43 21 48
                            C36 54 40 64 29 72
                            C19 80 8 72 12 63
                            C15 55 25 57 26 64

                            M29 72
                            C41 80 38 93 20 98
                        "
                              fill="none"
                              stroke="#0A3323"
                              stroke-width="2.7"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                        <circle cx="40" cy="42" r="2.2" fill="#839958" />
                        <circle cx="8" cy="87" r="1.8" fill="#839958" />

                    </svg>


                    <!--logo-->

                    <a class="navbar-brand logo-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <img src="~/images/logo-warzywniak.png"
                             alt="Warzywniak"
                             class="header-logo" />

                    </a>


                    <!--prawy ornament-->

                    <svg class="header-ornament ornament-right"
                         viewBox="0 0 50 100"
                         xmlns="http://www.w3.org/2000/svg"
                         aria-hidden="true">

                        <path d="
                            M37 2
                            C20 0 10 12 17 23
                            C23 33 38 28 35 18
                            C33 11 24 13 23 19

                            M17 23
                            C5 31 8 43 21 48
                            C36 54 40 64 29 72
                            C19 80 8 72 12 63
                            C15 55 25 57 26 64

                            M29 72
                            C41 80 38 93 20 98
                        "
                              fill="none"
                              stroke="#0A3323"
                              stroke-width="2.7"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                        <circle cx="40" cy="42" r="2.2" fill="#839958" />
                        <circle cx="8" cy="87" r="1.8" fill="#839958" />

                    </svg>

                </div>


                <!--prawa str menu-->

                <div class="header-profile">

                    <a class="btn btn-outline-dark d-flex align-items-center gap-2"
                       asp-controller="Account"
                       asp-action="Index"
                       title="Profil">

                        <i class="bi bi-person-fill fs-5"></i>
                        <span>Profil</span>

                    </a>

                </div>

            </div>

        </nav>
    </header>


    <div class="container flex-grow-1 my-4 p-4 rounded shadow-sm">

        <main role="main">
            @RenderBody()
        </main>

    </div>


    <footer class="site-footer mt-auto bg-white border-top py-3">

        <div class="container-fluid px-3 d-flex flex-wrap justify-content-between align-items-center">

            <!--lewa str-->

            <div class="footer-info">

                &copy; 2026 - <strong>Warzywniak</strong>

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="text-decoration-none ms-2">

                    Privacy

                </a>

            </div>


            <!--prawa str-->

            <div class="footer-counter d-flex align-items-center gap-2">

                <span>Licznik odwiedzin:</span>

                <span class="badge bg-dark rounded-pill px-3 py-2">
                    12345
                </span>

            </div>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
