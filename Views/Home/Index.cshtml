@section Scripts {
    <script>
        document.querySelectorAll(".image-switch").forEach(button => {
            button.addEventListener("click", event => {
                event.stopPropagation();

                const card = button.closest(".product-card");
                card.classList.toggle("show-second");
            });
        });
        document.querySelectorAll(".slider-wrapper").forEach(wrapper => {
            const slider = wrapper.querySelector(".product-slider");
            const prev = wrapper.querySelector(".slider-button.prev");
            const next = wrapper.querySelector(".slider-button.next");

            prev.addEventListener("click", () => {
                slider.scrollBy({ left: -slider.clientWidth * 0.8, behavior: "smooth" });
            });

            next.addEventListener("click", () => {
                slider.scrollBy({ left: slider.clientWidth * 0.8, behavior: "smooth" });
            });
        });
    </script>
}
