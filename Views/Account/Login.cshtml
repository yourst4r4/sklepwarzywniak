@model Warzywniak.ViewModels.LoginViewModel

<h2>Logowanie</h2>

<form asp-action="Login" method="post">

    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Login">Login lub email</label>
        <input asp-for="Login" />
        <span asp-validation-for="Login"></span>
    </div>

    <div>
        <label asp-for="Password">Hasło</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>

    <button type="submit">Zaloguj się</button>

</form>


<a asp-action="Register">Nie masz konta? Zarejestruj się</a>