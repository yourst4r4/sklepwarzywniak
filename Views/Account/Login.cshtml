@model Warzywniak.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Logowanie";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="account-page">
    <div class="account-card">

        <h1>Witaj ponownie!</h1>

        <p class="account-subtitle">
            Zaloguj się i wróć do swojego Warzywniaka.
        </p>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-errors"></div>

            <div class="form-group">
                <label asp-for="Login">Login lub e-mail</label>
                <input asp-for="Login"
                       class="form-control"
                       placeholder="Twój login lub adres e-mail"
                       autocomplete="username" />
                <span asp-validation-for="Login"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Hasło</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Twoje hasło"
                       autocomplete="current-password" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="account-button">
                Zaloguj się
            </button>
        </form>

        <p class="account-switch">
            Nie masz jeszcze konta?
            <a asp-controller="Account" asp-action="Register">
                Zarejestruj się
            </a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}