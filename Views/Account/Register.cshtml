
@model Warzywniak.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Rejestracja";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="account-page">
    <div class="account-card">

        <h1>Dołącz do Warzywniaka!</h1>

        <p class="account-subtitle">
            Załóż konto i ciesz się świeżymi zakupami.
        </p>

        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-errors"></div>

            <div class="form-group">
                <label asp-for="FirstName">Imię</label>
                <input asp-for="FirstName"
                       class="form-control"
                       autocomplete="given-name" />
                <span asp-validation-for="FirstName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName">Nazwisko</label>
                <input asp-for="LastName"
                       class="form-control"
                       autocomplete="family-name" />
                <span asp-validation-for="LastName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Login">Login</label>
                <input asp-for="Login"
                       class="form-control"
                       autocomplete="username" />
                <span asp-validation-for="Login"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Adres e-mail</label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       autocomplete="email" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Hasło</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="account-button">
                Utwórz konto
            </button>
        </form>

        <p class="account-switch">
            Masz już konto?
            <a asp-controller="Account" asp-action="Login">
                Zaloguj się
            </a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
